# ==========================================
# MEDVAULT AI - Environment Variables
# ==========================================

# Flask Backend Config
PORT=5000
FLASK_ENV=development
SECRET_KEY=medvault-ai-super-secret-security-key-2026

# Google Gemini API (Get key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase Configuration (Optional - MedVault AI runs out-of-the-box in dual mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notification Providers (Optional - Simulated Demo mode is built-in)
EMAIL_API_KEY=
SMS_API_KEY=

# Frontend Vite Variables (.env.local in frontend/)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://localhost:5000/api
